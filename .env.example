# WapKidLearn — Environment Variables
# Copy ke .env dan sesuaikan nilainya. Jangan commit .env ke git!

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=wapkidlearn
DB_PASSWORD=ganti_ini_dengan_password_kuat
DB_NAME=wapkidlearn_db
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?sslmode=disable

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=8080
JWT_SECRET=ganti_ini_dengan_random_string_minimal_32_karakter
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ── Production (Cloudflare Tunnel) ────────────────────────────────────────────
# ALLOWED_ORIGINS=https://wapkidlearn.yourdomain.com
# NEXT_PUBLIC_API_URL=https://wapkidlearn.yourdomain.com/api/v1
